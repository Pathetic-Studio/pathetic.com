NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SANITY CMS
# use current date (YYYY-MM-DD) to target the latest API version
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-18
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# GEMINI AI (for meme generation)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.0-flash

# SUPABASE (for auth and credits)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# STRIPE (for payments)
# Get these from: https://dashboard.stripe.com/test/apikeys (use TEST mode)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Get webhook secret from: https://dashboard.stripe.com/test/webhooks
# For local development, use Stripe CLI: stripe listen --forward-to localhost:3000/api/booth/webhook
STRIPE_WEBHOOK_SECRET=

# BEEHIIV (for newsletter subscriptions)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# CONTACT FORM EMAIL (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
CONTACT_TO_EMAIL=
